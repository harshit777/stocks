# Production Trading Configuration
# Copy this to .env and fill in your values


# === Trading Mode ===
# Options: paper | dry-run | live
# paper: Simulated trading with virtual money
# dry-run: Connect to live market but don't place orders (testing)
# live: Real trading with real money (use with EXTREME caution)
TRADING_MODE=paper

# === Order Execution Settings ===
# Maximum time to wait for order completion (seconds)
ORDER_TIMEOUT=30

# Slippage tolerance for LIMIT orders (0.003 = 0.3%)
SLIPPAGE_TOLERANCE=0.003

# Maximum retry attempts for failed API calls
MAX_RETRIES=3

# === Rate Limiting ===
# Zerodha limit: 3 requests per second
RATE_LIMIT=3.0

# === Risk Management ===
# Maximum position size as % of capital (0.08 = 8%)
MAX_POSITION_PCT=0.08

# Stop loss percentage (0.02 = 2%)
STOP_LOSS_PCT=0.02

# Minimum profit margin required (0.015 = 1.5%)
MIN_PROFIT_MARGIN=0.015

# Maximum daily loss limit (0.05 = 5% of capital)
MAX_DAILY_LOSS_PCT=0.05

# === AI Settings ===
# Minimum AI confidence to influence trades (0.6 = 60%)
AI_CONFIDENCE_THRESHOLD=0.6

# === Position Reconciliation ===
# Enable periodic position reconciliation with broker
ENABLE_POSITION_RECONCILIATION=true

# Position reconciliation interval (seconds)
POSITION_RECONCILIATION_INTERVAL=300

# === Logging ===
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Enable detailed API logging
API_DEBUG_LOGGING=false

# === Emergency Controls ===
# Emergency stop file (if exists, trading stops immediately)
EMERGENCY_STOP_FILE=data/EMERGENCY_STOP

# Maximum trades per day (safety limit)
MAX_DAILY_TRADES=50

# === Notifications (Optional) ===
# Enable trade notifications
ENABLE_NOTIFICATIONS=false

# Email for critical alerts
ALERT_EMAIL=

# Telegram bot token (for notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
